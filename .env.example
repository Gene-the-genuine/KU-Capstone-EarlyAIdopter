# =====================================================================
#  회기노트 환경변수 견본
#  1) 이 파일을 복사해서 .env.local 을 만들고:  cp .env.example .env.local
#  2) 아래 빈 값을 채웁니다. (.env.local 은 git 에 올라가지 않습니다)
#  3) 배포할 때는 같은 이름으로 Vercel → Project → Settings → Environment Variables 에 넣습니다.
#  키는 깃허브·카톡 단톡방에 올리지 말고 팀원끼리 1:1 로 비공개 공유하세요.
# =====================================================================

# [필수] Supabase 프로젝트 주소
#   Supabase 대시보드 → 프로젝트 → Connect(또는 Project Settings → Data API)의 Project URL
#   예) https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# [필수] Supabase secret key (sb_secret_ 로 시작)
#   Supabase 대시보드 → Project Settings → API Keys → Secret keys
#   ⚠️ 서버 전용 키입니다. 이름 앞에 NEXT_PUBLIC_ 을 붙이거나 브라우저 코드에 쓰면 안 됩니다.
#   (publishable key 는 이 앱에서 쓰지 않습니다)
SUPABASE_SECRET_KEY=

# [필수] 로그인 쿠키 암호화용 비밀값 (32자 이상 무작위 문자열)
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   바꾸면 모든 상담사가 로그아웃됩니다.
SESSION_SECRET=

# [AI 정리] AI API 키. 둘 중 하나를 넣습니다.
#   ① 학교 키 (추천): llm.korea.ac.kr 로그인 → 왼쪽 아래 API Gateway → API 키 생성 (baze_ 로 시작)
#      키를 만든 사람의 월 크레딧에서 차감되므로, 팀원은 각자 자기 키를 발급받아 쓰세요.
#   ② OpenAI 키 (유료): https://platform.openai.com/api-keys (sk- 로 시작)
#   비워 두면 AI 정리 버튼이 "AI 설정이 없습니다" 오류를 냅니다.
OPENAI_API_KEY=

# [AI 정리] AI API 주소. ① 학교 키면 아래 값 그대로 두고, ② OpenAI 키면 이 줄을 지우세요.
OPENAI_BASE_URL=https://api.baze.co/v1/gateway

# [AI 정리] 사용할 모델. 기본값 gpt-6-luna (학교 키·OpenAI 키 모두 같은 이름)
OPENAI_MODEL=gpt-6-luna

# [AI 정리] 추론 강도: none / low / medium / high  (낮을수록 빠르고 저렴)
#   이 줄을 지우면 모델 기본값(medium)을 씁니다. 추론을 지원하지 않는 모델로 바꾸면 이 줄을 지우세요.
OPENAI_REASONING_EFFORT=low

# [선택] true 면 AI 를 부르지 않고 예시 결과를 1초 뒤에 돌려줍니다.
#   AI 키 없이 화면을 개발하거나 크레딧을 아낄 때 쓰세요. 배포 환경에서는 false.
AI_MOCK=false
